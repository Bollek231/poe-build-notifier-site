# PRZYKLADOWA KONFIGURACJA. SKOPIUJ DO .env I WYPELNIJ LOKALNIE.
# NIE UDOSTEPNIAJ PRAWDZIWEGO PLIKU .env ANI KLUCZY.
DISCORD_TOKEN=WPISZ_TUTAJ_TOKEN_BOTA
DISCORD_CHANNEL_ID=0
YOUTUBE_API_KEY=WPISZ_TUTAJ_KLUCZ_YOUTUBE
CHECK_INTERVAL_HOURS=2
SEND_DELAY_SECONDS=3
MAX_VIDEO_AGE_HOURS=24
YOUTUBE_CACHE_DAYS=7
DAILY_DIGEST_ENABLED=true
DAILY_DIGEST_TIME=20:00
TARGET_LEAGUE=3.30
# PoE 2 defaults to release 1.0 when you switch with pGame poe2
POE2_TARGET_VERSION=1.0
# DAILY_DIGEST_CHANNEL_ID=0
# MAX_RESULTS_PER_QUERY=25
# DAILY_SEARCH_BUDGET=96
# RESERVED_SEARCHES=24

# PoE Build Notifier v0.6.4b – opcjonalne ustawienia
# ALERT_CHANNEL_ID=0  # 0 = bez alertów; domyślnie kanał buildów
# CHECK_EXTERNAL_LINKS=true
# LINK_REFRESH_INTERVAL_HOURS=6
# MAX_LINK_REFRESH_PER_RUN=10
# BACKUP_DIR=backups  # na Railway/VPS użyj trwałego dysku, np. /data/backups
# BACKUP_KEEP_DAYS=7
# VERSION_CHECK_ENABLED=true
# VERSION_CHECK_INTERVAL_HOURS=12  # 1–72 godzin; można zmienić w pSettings
# DAILY_SEARCH_BUDGET=96  # tylko lokalny limit bota; dostosuj do przyznanej quoty Google

# pLanguage i pSettings zapisują preferencje do SQLite (bot_settings);
# .env pozostaje źródłem wartości domyślnych, tokeny nie są edytowalne w Discordzie.

# Opcjonalne tłumaczenie tytułów, domyślnie wyłączone.
# Wybierz silnik przez pTranslateTitles mymemory / google lub pSettings.
# MyMemory: bez klucza i rozliczeń, darmowy limit dostawcy 5000 znaków/dzień.
# TRANSLATION_PROVIDER=mymemory
# MYMEMORY_CONTACT_EMAIL=you@example.com  # opcjonalne; większy darmowy limit
# Google Cloud Translation Basic v2: wymaga klucza API i rozliczeń.
# TRANSLATION_PROVIDER=google
# TRANSLATION_API_KEY=YOUR_PRIVATE_CLOUD_TRANSLATION_KEY
# TRANSLATION_DAILY_LIMIT=30  # 1–100 prób na 24h, niezależnie od dostawcy
# Aktywacja: pTranslateTitles on; wyłączenie: pTranslateTitles off.

# v0.6.4b: osobny kanał dla strategii farmienia (opcjonalny; domyślnie kanał buildów).
# FARM_CHANNEL_ID=0
# Automatyczne wyszukiwanie strategii jest domyślnie wyłączone.
# Włącz na Discordzie: pFarmAuto on; testowo: pFarmSearch essence
